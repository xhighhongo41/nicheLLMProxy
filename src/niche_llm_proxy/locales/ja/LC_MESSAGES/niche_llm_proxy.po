msgid ""
msgstr ""
"Project-Id-Version: nicheLLM Proxy 1.2.2\n"
"PO-Revision-Date: 2026-07-26 00:00+0000\n"
"Last-Translator: nicheLLM Proxy contributors\n"
"Language-Team: Japanese\n"
"Language: ja\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Configuration error: {error}"
msgstr "設定エラー: {error}"

msgid "Upstream API key environment variable '{api_key_env}' is not set."
msgstr "上流APIキーの環境変数 '{api_key_env}' が設定されていません。"

msgid "Configuration file was not found: {path}"
msgstr "設定ファイルが見つかりません: {path}"

msgid "Unable to read the configuration JSON."
msgstr "設定JSONを読み込めません。"

msgid "Top-level configuration JSON must be an object."
msgstr "設定JSONの最上位はオブジェクトである必要があります。"

msgid "Since v1.4 the configuration requires a top-level 'listeners' array. See the README for the migration guide."
msgstr "v1.4以降の設定には最上位の 'listeners' 配列が必要です。移行手順はREADMEを参照してください。"

msgid "'listeners' must be a non-empty array of listener objects."
msgstr "'listeners' は空でないリスナーオブジェクトの配列である必要があります。"

msgid "Each 'listeners' item must be an object."
msgstr "'listeners' の各項目はオブジェクトである必要があります。"

msgid "'listeners' contains duplicate ports: {ports}."
msgstr "'listeners' に重複したポートがあります: {ports}。"

msgid "Multiple listeners write protocol logs to the same file: {paths}."
msgstr "複数のリスナーが同じファイルへプロトコルログを書き込みます: {paths}。"

msgid "Configuration item '{key}' must be an object."
msgstr "設定項目 '{key}' はオブジェクトである必要があります。"

msgid "listener.port must be an integer between 1 and 65535."
msgstr "listener.port は1から65535までの整数である必要があります。"

msgid "listener.mode must be 'passthrough', 'grok-image', 'grok-image-edit', 'gemini-image' or 'featherless'."
msgstr "listener.mode は 'passthrough'、'grok-image'、'grok-image-edit'、'gemini-image' または 'featherless' である必要があります。"

msgid "listener.grok_image.{key} must be a non-empty string."
msgstr "listener.grok_image.{key} は空でない文字列である必要があります。"

msgid "listener.grok_image.resolution must be '1k' or '2k'."
msgstr "listener.grok_image.resolution は '1k' または '2k' である必要があります。"

msgid "listener.gemini_image.{key} must be a non-empty string."
msgstr "listener.gemini_image.{key} は空でない文字列である必要があります。"

msgid "upstream.api_key_env is not used in 'featherless' mode. The proxy relays the client's Authorization header."
msgstr "upstream.api_key_env は 'featherless' モードでは使用されません。プロキシはクライアントのAuthorizationヘッダーを転送します。"

msgid "listener.featherless.model_whitelist is required."
msgstr "listener.featherless.model_whitelist は必須です。"

msgid "listener.featherless.model_whitelist must be an array of model id strings."
msgstr "listener.featherless.model_whitelist はモデルID文字列の配列である必要があります。"

msgid "listener.featherless.model_whitelist must contain at least one model id."
msgstr "listener.featherless.model_whitelist には1件以上のモデルIDが必要です。"

msgid "listener.featherless.model_whitelist must not contain duplicate model ids."
msgstr "listener.featherless.model_whitelist に重複したモデルIDを指定できません。"

msgid "listener.featherless.{key} must be a positive integer."
msgstr "listener.featherless.{key} は0より大きい整数である必要があります。"

msgid "listener.featherless.{key} must be a positive number."
msgstr "listener.featherless.{key} は0より大きい数値である必要があります。"

msgid "The requested model is not in the whitelist of 'featherless' mode."
msgstr "要求されたモデルは 'featherless' モードのホワイトリストに含まれていません。"

msgid "The requested model is not available in 'featherless' mode."
msgstr "要求されたモデルは 'featherless' モードでは利用できません。"

msgid "The request was rejected because the wait for upstream concurrency capacity exceeded the limit, in 'featherless' mode."
msgstr "上流の同時接続キャパシティの待機が上限を超えたため、要求は拒否されました('featherless'モード)。"

msgid "The client disconnected while waiting for upstream concurrency capacity in 'featherless' mode."
msgstr "上流の同時接続キャパシティの待機中にクライアントが切断されたため、要求を中止しました('featherless'モード)。"


msgid "listener.features must be an array."
msgstr "listener.features は配列である必要があります。"

msgid "Each listener.features item must be an object."
msgstr "listener.features の各項目はオブジェクトである必要があります。"

msgid "listener.features supports only 'logging'."
msgstr "listener.features で指定できるのは 'logging' だけです。"

msgid "listener.features must not contain duplicate 'logging'."
msgstr "listener.features に 'logging' を重複して指定できません。"

msgid "logging feature config must be an object."
msgstr "logging フィーチャーのconfigはオブジェクトである必要があります。"

msgid "logging must enable stdout or file output."
msgstr "loggingではstdoutまたはfile出力を有効にする必要があります。"

msgid "logging.file.path must be an absolute path."
msgstr "logging.file.path は絶対パスである必要があります。"

msgid "logging.capture.max_body_bytes must not exceed {maximum}."
msgstr "logging.capture.max_body_bytes は {maximum} 以下である必要があります。"

msgid "upstream.base_url must be a valid HTTP(S) URL."
msgstr "upstream.base_url は有効なHTTP(S) URLである必要があります。"

msgid "upstream.base_url must be an HTTP(S) URL without a query or fragment."
msgstr "upstream.base_url はクエリとフラグメントを含まないHTTP(S) URLである必要があります。"

msgid "Configuration item '{key}' must be a non-empty string."
msgstr "設定項目 '{key}' は空でない文字列である必要があります。"

msgid "Configuration item '{key}' must be a boolean."
msgstr "設定項目 '{key}' は真偽値である必要があります。"

msgid "Configuration item '{key}' must be a positive integer."
msgstr "設定項目 '{key}' は0より大きい整数である必要があります。"

msgid "Configuration item '{key}' must be an array of names."
msgstr "設定項目 '{key}' は名前の配列である必要があります。"

msgid "Configuration item '{context}' has unknown fields: {fields}."
msgstr "設定項目 '{context}' に未知のフィールドがあります: {fields}。"

msgid "timeouts.{key} must be a positive number."
msgstr "timeouts.{key} は0より大きい数値である必要があります。"

msgid "The upstream provider timed out."
msgstr "上流プロバイダーがタイムアウトしました。"

msgid "Unable to connect to the upstream provider."
msgstr "上流プロバイダーへ接続できません。"

msgid "This path is not supported in 'grok-image' mode."
msgstr "この経路は 'grok-image' モードではサポートされていません。"

msgid "This path is not supported in 'gemini-image' mode."
msgstr "この経路は 'gemini-image' モードではサポートされていません。"

msgid "Request body must be a JSON object in 'grok-image' mode."
msgstr "'grok-image' モードでは、リクエスト本文はJSONオブジェクトである必要があります。"

msgid "'prompt' must be a non-empty string."
msgstr "'prompt' は空でない文字列である必要があります。"

msgid "'model' is required when no default model is configured."
msgstr "既定モデルが設定されていない場合、'model' は必須です。"

msgid "'n' must be an integer between 1 and 10."
msgstr "'n' は1から10までの整数である必要があります。"

msgid "'n' must be an integer equal to 1."
msgstr "'n' は1に等しい整数である必要があります。"

msgid "'n' greater than 1 is not supported in 'gemini-image' mode."
msgstr "'gemini-image' モードでは、1より大きい 'n' はサポートされていません。"

msgid "'response_format' must be 'url' or 'b64_json'."
msgstr "'response_format' は 'url' または 'b64_json' である必要があります。"

msgid "Request body must be a JSON object in 'gemini-image' mode."
msgstr "'gemini-image' モードでは、リクエスト本文はJSONオブジェクトである必要があります。"

msgid "'response_format' must be 'b64_json' in 'gemini-image' mode."
msgstr "'gemini-image' モードでは、'response_format' は 'b64_json' である必要があります。"

msgid "nicheLLM Proxy {version} starting with {count} listener."
msgstr "nicheLLM Proxy {version} を起動します。リスナー数: {count}。"

msgid "nicheLLM Proxy {version} starting with {count} listeners."
msgstr "nicheLLM Proxy {version} を起動します。リスナー数: {count}。"

msgid "  - port {port}: mode '{mode}' with features: {features}."
msgstr "  - ポート {port}: モード '{mode}'、フィーチャー: {features}。"

msgid "  - port {port}: mode '{mode}' with no features."
msgstr "  - ポート {port}: モード '{mode}'、フィーチャーはありません。"

msgid "Skipped the listener on port {port} because mode '{mode}' requires a '{section}' section, which is missing from the configuration."
msgstr "モード '{mode}' には '{section}' セクションが必要ですが設定に存在しないため、ポート {port} のリスナーをスキップしました。"

msgid "No listeners can be started because every listener was skipped. Skipped ports: {ports}."
msgstr "すべてのリスナーがスキップされたため、リスナーを起動できません。スキップされたポート: {ports}。"

msgid "The 'featherless' mode requires a 'featherless' section in the configuration."
msgstr "'featherless' モードには設定内の 'featherless' セクションが必要です。"

msgid "Unknown top-level configuration keys were ignored: {keys}."
msgstr "未知の最上位設定キーは無視されました: {keys}。"

msgid "listener.grok_image is ignored because listener.mode is not 'grok-image'."
msgstr "listener.grok_image は listener.mode が 'grok-image' でないため無視されました。"

msgid "listener.gemini_image is ignored because listener.mode is not 'gemini-image'."
msgstr "listener.gemini_image は listener.mode が 'gemini-image' でないため無視されました。"

msgid "listener.featherless is ignored because listener.mode is not 'featherless'."
msgstr "listener.featherless は listener.mode が 'featherless' でないため無視されました。"

msgid "logging.file settings were ignored because logging.file.enabled is false."
msgstr "logging.file.enabled が false のため、logging.file の設定は無視されました。"

msgid "Request body must be multipart/form-data in 'grok-image-edit' mode."
msgstr "'grok-image-edit' モードでは、リクエスト本文は multipart/form-data である必要があります。"

msgid "Malformed multipart/form-data body."
msgstr "multipart/form-data ボディの形式が不正です。"

msgid "mask is not supported in 'grok-image-edit' mode."
msgstr "'grok-image-edit' モードでは mask はサポートされていません。"

msgid "Unsupported image type. Only PNG, JPEG and WebP are accepted."
msgstr "サポートされていない画像形式です。PNG、JPEG、WebP のみ受け付けます。"

msgid "'image' must be an http(s) or data URL when sent as a text field."
msgstr "テキストフィールドとして送信される 'image' は http(s) または data URL である必要があります。"

msgid "At least one input image is required."
msgstr "入力画像は1つ以上必要です。"

msgid "Unexpected file part '{name}' was rejected."
msgstr "予期しないファイルパート '{name}' は拒否されました。"

msgid "listener.grok_image_edit.{key} must be a non-empty string."
msgstr "listener.grok_image_edit.{key} は空でない文字列である必要があります。"

msgid "listener.grok_image_edit.resolution must be '1k' or '2k'."
msgstr "listener.grok_image_edit.resolution は '1k' または '2k' である必要があります。"

msgid "listener.grok_image_edit is ignored because listener.mode is not 'grok-image-edit'."
msgstr "listener.grok_image_edit は listener.mode が 'grok-image-edit' でないため無視されました。"

msgid "This path is not supported in 'grok-image-edit' mode."
msgstr "この経路は 'grok-image-edit' モードではサポートされていません。"
