# Set the key for the upstream OpenAI-compatible API. Store real values only in .env.
UPSTREAM_API_KEY=

# Optional: set the xAI API key for the grok-image listener mode. Store real values only in .env.
XAI_API_KEY=xai-...

# Optional: select user-facing proxy messages (en or ja). English is the default.
NICHELLM_LANGUAGE=en
